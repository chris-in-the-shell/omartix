# Release the boot splash before SDDM takes VT1. If plymouth still holds the
# DRM device, start-hyprland exits immediately and SDDM falls back to a greeter
# that never paints over the splash.
type = scripted
command = /bin/sh -c 'if command -v plymouth >/dev/null; then plymouth quit || true; fi'
depends-on = local.target
before = sddm
restart = false
